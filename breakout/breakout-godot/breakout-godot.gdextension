[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.3"

[libraries]
linux.debug.x86_64 = "res://target/debug/libbreakout_godot.so"
linux.release.x86_64 = "res://target/release/libbreakout_godot.so"
windows.debug.x86_64 = "res://target/debug/breakout_godot.dll"
windows.release.x86_64 = "res://target/release/breakout_godot.dll"
macos.debug = "res://target/debug/libbreakout_godot.dylib"
macos.release = "res://target/release/libbreakout_godot.dylib"
