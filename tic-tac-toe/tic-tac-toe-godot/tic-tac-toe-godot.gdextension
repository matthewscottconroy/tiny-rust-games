[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.1"

[libraries]
linux.debug.x86_64 = "res://target/debug/libtic_tac_toe_godot.so"
linux.release.x86_64 = "res://target/release/libtic_tac_toe_godot.so"
windows.debug.x86_64 = "res://target/debug/tic_tac_toe_godot.dll"
windows.release.x86_64 = "res://target/release/tic_tac_toe_godot.dll"
macos.debug = "res://target/debug/libtic_tac_toe_godot.dylib"
macos.release = "res://target/release/libtic_tac_toe_godot.dylib"
