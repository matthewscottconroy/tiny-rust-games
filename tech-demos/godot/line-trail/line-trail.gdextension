[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.1"

[libraries]
linux.debug.x86_64   = "res://target/debug/libline_trail.so"
linux.release.x86_64 = "res://target/release/libline_trail.so"
windows.debug.x86_64   = "res://target/debug/line_trail.dll"
windows.release.x86_64 = "res://target/release/line_trail.dll"
macos.debug   = "res://target/debug/libline_trail.dylib"
macos.release = "res://target/release/libline_trail.dylib"
