[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.3"

[libraries]
linux.debug.x86_64 = "res://target/debug/libscene_tree.so"
linux.release.x86_64 = "res://target/release/libscene_tree.so"
windows.debug.x86_64 = "res://target/debug/scene_tree.dll"
windows.release.x86_64 = "res://target/release/scene_tree.dll"
macos.debug = "res://target/debug/libscene_tree.dylib"
macos.release = "res://target/release/libscene_tree.dylib"
