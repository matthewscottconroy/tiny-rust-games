[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.1"

[libraries]
linux.debug.x86_64 = "res://target/debug/libexported_properties.so"
linux.release.x86_64 = "res://target/release/libexported_properties.so"
windows.debug.x86_64 = "res://target/debug/exported_properties.dll"
windows.release.x86_64 = "res://target/release/exported_properties.dll"
macos.debug = "res://target/debug/libexported_properties.dylib"
macos.release = "res://target/release/libexported_properties.dylib"
