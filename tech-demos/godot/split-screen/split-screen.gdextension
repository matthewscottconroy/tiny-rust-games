[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.3"

[libraries]
linux.debug.x86_64   = "res://target/debug/libsplit_screen.so"
linux.release.x86_64 = "res://target/release/libsplit_screen.so"
windows.debug.x86_64   = "res://target/debug/split_screen.dll"
windows.release.x86_64 = "res://target/release/split_screen.dll"
macos.debug   = "res://target/debug/libsplit_screen.dylib"
macos.release = "res://target/release/libsplit_screen.dylib"
