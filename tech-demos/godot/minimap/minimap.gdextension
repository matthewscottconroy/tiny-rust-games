[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.1"

[libraries]
linux.debug.x86_64   = "res://target/debug/libminimap.so"
linux.release.x86_64 = "res://target/release/libminimap.so"
windows.debug.x86_64   = "res://target/debug/minimap.dll"
windows.release.x86_64 = "res://target/release/minimap.dll"
macos.debug   = "res://target/debug/libminimap.dylib"
macos.release = "res://target/release/libminimap.dylib"
