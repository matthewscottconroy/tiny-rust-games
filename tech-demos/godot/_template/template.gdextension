[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.3"

[libraries]
linux.debug.x86_64 = "res://target/debug/libtemplate.so"
linux.release.x86_64 = "res://target/release/libtemplate.so"
windows.debug.x86_64 = "res://target/debug/template.dll"
windows.release.x86_64 = "res://target/release/template.dll"
macos.debug = "res://target/debug/libtemplate.dylib"
macos.release = "res://target/release/libtemplate.dylib"
