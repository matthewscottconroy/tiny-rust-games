[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.1"

[libraries]
linux.debug.x86_64   = "res://target/debug/libcamera_zoom.so"
linux.release.x86_64 = "res://target/release/libcamera_zoom.so"
windows.debug.x86_64   = "res://target/debug/camera_zoom.dll"
windows.release.x86_64 = "res://target/release/camera_zoom.dll"
macos.debug   = "res://target/debug/libcamera_zoom.dylib"
macos.release = "res://target/release/libcamera_zoom.dylib"
