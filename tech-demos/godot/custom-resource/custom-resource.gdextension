[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.3"

[libraries]
linux.debug.x86_64 = "res://target/debug/libcustom_resource.so"
linux.release.x86_64 = "res://target/release/libcustom_resource.so"
windows.debug.x86_64 = "res://target/debug/custom_resource.dll"
windows.release.x86_64 = "res://target/release/custom_resource.dll"
macos.debug = "res://target/debug/libcustom_resource.dylib"
macos.release = "res://target/release/libcustom_resource.dylib"
