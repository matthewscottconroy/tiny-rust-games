[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.1"

[libraries]
linux.debug.x86_64   = "res://target/debug/libhitbox_hurtbox.so"
linux.release.x86_64 = "res://target/release/libhitbox_hurtbox.so"
windows.debug.x86_64   = "res://target/debug/hitbox_hurtbox.dll"
windows.release.x86_64 = "res://target/release/hitbox_hurtbox.dll"
macos.debug   = "res://target/debug/libhitbox_hurtbox.dylib"
macos.release = "res://target/release/libhitbox_hurtbox.dylib"
