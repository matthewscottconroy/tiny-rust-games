[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.3"

[libraries]
linux.debug.x86_64 = "res://target/debug/libplayer_movement.so"
linux.release.x86_64 = "res://target/release/libplayer_movement.so"
windows.debug.x86_64 = "res://target/debug/player_movement.dll"
windows.release.x86_64 = "res://target/release/player_movement.dll"
macos.debug = "res://target/debug/libplayer_movement.dylib"
macos.release = "res://target/release/libplayer_movement.dylib"
