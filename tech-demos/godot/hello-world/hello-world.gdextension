[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.1"

[libraries]
linux.debug.x86_64 = "res://target/debug/libhello_world.so"
linux.release.x86_64 = "res://target/release/libhello_world.so"
windows.debug.x86_64 = "res://target/debug/hello_world.dll"
windows.release.x86_64 = "res://target/release/hello_world.dll"
macos.debug = "res://target/debug/libhello_world.dylib"
macos.release = "res://target/release/libhello_world.dylib"
